{
  "name": "devvegis",
  "version": "1.0.0",
  "description": "Fresh Fruits & Vegetables Delivered in Minutes",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "db:generate": "cd prisma && npx prisma generate",
    "db:migrate": "cd prisma && npx prisma migrate dev",
    "db:seed": "cd prisma && npx ts-node seed.ts",
    "db:studio": "cd prisma && npx prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2"
  }
}
