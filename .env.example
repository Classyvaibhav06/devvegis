# Database
DATABASE_URL="postgresql://devvegis:devvegis_password@localhost:5432/devvegis_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Auth Secrets
JWT_ACCESS_SECRET="devvegis_jwt_access_super_secret_key_change_in_prod"
JWT_REFRESH_SECRET="devvegis_jwt_refresh_super_secret_key_change_in_prod"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Razorpay Sandbox (Payments)
RAZORPAY_KEY_ID="rzp_test_sample_key"
RAZORPAY_KEY_SECRET="sample_secret_key"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="sample@devvegis.com"
EMAIL_PASS="app_password"
EMAIL_FROM="DevVegis <orders@devvegis.com>"

# Quick Commerce Settings
DELIVERY_FEE=25
FREE_DELIVERY_ABOVE=199
GST_RATE=0.05
MAX_FILE_SIZE=5242880

# Neon Object Storage (S3-compatible, 5 GB free)
AWS_ACCESS_KEY_ID="your_neon_s3_access_key"
AWS_SECRET_ACCESS_KEY="your_neon_s3_secret_key"
AWS_ENDPOINT_URL_S3="https://storage.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"
AWS_BUCKET_NAME="uploads"

